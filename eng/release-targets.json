{
  "schemaVersion": 1,
  "project": "HandyPlayer",
  "stateDirectory": ".harness/remote-release",
  "worktreeDirectory": ".wt",
  "targets": {
    "win-x64": {
      "host": "windows11-vm",
      "platform": "windows",
      "architecture": "x64",
      "parameters": {"packageProfile": {"default": "Candidate", "requiredModes": ["validate", "package", "upload"], "pattern": "Candidate|Full"}},
      "commands": {
        "validate": [["pwsh", "-NoProfile", "-NonInteractive", "-File", "eng/restore-tools.ps1"], ["pwsh", "-NoProfile", "-NonInteractive", "-File", "eng/restore-native.ps1", "-EvidencePath", "{output}/native-validation.json"], ["pwsh", "-NoProfile", "-NonInteractive", "-File", "eng/release.ps1", "-Target", "{target}", "-Mode", "validate", "-ExpectedSha", "{commit}", "-OutputDirectory", "{output}", "-PackageProfile", "{param:packageProfile}", "-MaxParallelism", "{jobs}"]],
        "package": [["pwsh", "-NoProfile", "-NonInteractive", "-File", "eng/release.ps1", "-Target", "{target}", "-Mode", "package", "-ExpectedSha", "{commit}", "-OutputDirectory", "{output}", "-PackageProfile", "{param:packageProfile}", "-MaxParallelism", "{jobs}"]],
        "upload": [["pwsh", "-NoProfile", "-NonInteractive", "-File", "eng/release.ps1", "-Target", "{target}", "-Mode", "upload", "-ExpectedSha", "{commit}", "-OutputDirectory", "{output}", "-PackageProfile", "{param:packageProfile}", "-MaxParallelism", "{jobs}"]]
      },
      "artifacts": ["artifacts/HandyPlayer-*-win-x64.zip", "artifacts/HandyPlayer-*-win-x64.msi", "artifacts/HandyPlayer-*-win-x64-setup.exe", "artifacts/SHA256SUMS-win-x64.txt", "artifacts/native-dependency.json", "artifact-manifest.json", "draft-manifest.json", "draft-upload.json"],
      "uploadPolicy": "draft-only",
      "notes": ["Requires native .NET SDK 11.0.100 (latestFeature), PowerShell 7, existing 7-Zip and the pinned project-local WiX 6.0.2 restore. Candidate uses medium CAB compression with ZIP plus required MSI, omitting only optional Inno EXE; --parameter packageProfile=Full retains automatic Inno packaging when installed. Canonical publisher defaults to Full.", "Canonical publishing restores the locked non-v3 libmpv build with archive/DLL hashes and PE x64 verification; unknown existing DLLs fail without replacement. Full software validation and matching SHA/profile receipts remain required.", "Explicit upload creates only ci-test GitHub draft candidates in Belgian-Coder/HandyPlayer using existing gh auth. Native playback/device/installer acceptance is separate."]
    },
    "osx-arm64": {
      "host": "macbook-pro",
      "platform": "macos",
      "architecture": "arm64",
      "commands": {
        "validate": [["pwsh", "-NoProfile", "-NonInteractive", "-File", "eng/release.ps1", "-Target", "{target}", "-Mode", "validate", "-ExpectedSha", "{commit}", "-OutputDirectory", "{output}", "-MaxParallelism", "{jobs}"]],
        "package": [["pwsh", "-NoProfile", "-NonInteractive", "-File", "eng/release.ps1", "-Target", "{target}", "-Mode", "package", "-ExpectedSha", "{commit}", "-OutputDirectory", "{output}", "-MaxParallelism", "{jobs}"]],
        "upload": [["pwsh", "-NoProfile", "-NonInteractive", "-File", "eng/release.ps1", "-Target", "{target}", "-Mode", "upload", "-ExpectedSha", "{commit}", "-OutputDirectory", "{output}", "-MaxParallelism", "{jobs}"]]
      },
      "artifacts": ["artifacts/HandyPlayer-*-mac-arm64.zip", "artifacts/HandyPlayer-*-mac-arm64.dmg", "artifact-manifest.json", "draft-manifest.json", "draft-upload.json"],
      "uploadPolicy": "draft-only",
      "notes": ["Requires a native ARM64 macOS host, ARM64 PowerShell 7, .NET SDK 11.0.100 (latestFeature), native libmpv/dependencies and macOS packaging tools.", "publish-mac.sh retains ad-hoc signing and strict verification. Developer ID signing, notarization and Intel Mac release acceptance are not implemented.", "PREBUILT_DIR is not used by the adapter and does not establish native validation. Draft candidates still require separate native playback/device acceptance."]
    }
  }
}
