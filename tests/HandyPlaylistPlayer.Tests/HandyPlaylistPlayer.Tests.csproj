<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests run on Microsoft.Testing.Platform (global.json), which xunit.v3 hosts natively. Do not add the VSTest
         packages (Microsoft.NET.Test.Sdk, xunit.runner.visualstudio, coverlet.collector): they are unused here, and Microsoft.NET.Test.Sdk
         pulls in Microsoft.CodeCoverage, whose MsCoverageReferencedPathMaps target runs an extra MSBuild pass over every
         referenced project before each compile. -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="23.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <!-- Avalonia types needed for AccentColors + resource-dictionary tests.
         Headless.XUnit is intentionally excluded: it ships xunit.core v2 which
         conflicts with xunit.v3. Resource tests use AvaloniaTestFixture instead. -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HandyPlaylistPlayer.Core\HandyPlaylistPlayer.Core.csproj" />
    <ProjectReference Include="..\..\src\HandyPlaylistPlayer.Devices.HandyApi\HandyPlaylistPlayer.Devices.HandyApi.csproj" />
    <ProjectReference Include="..\..\src\HandyPlaylistPlayer.Devices.Intiface\HandyPlaylistPlayer.Devices.Intiface.csproj" />
    <ProjectReference Include="..\..\src\HandyPlaylistPlayer.Storage\HandyPlaylistPlayer.Storage.csproj" />
    <ProjectReference Include="..\..\src\HandyPlaylistPlayer.App\HandyPlaylistPlayer.App.csproj" />
    <ProjectReference Include="..\..\src\HandyPlaylistPlayer.Media.Mpv\HandyPlaylistPlayer.Media.Mpv.csproj" />
  </ItemGroup>
</Project>
